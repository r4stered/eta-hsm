# Single C++26 baseline on GCC 16 with P2996 reflection (ADR-0001).
build --cxxopt=-std=c++26
build --cxxopt=-freflection

# C++26 contracts (P2900). -fcontracts is needed to parse a header carrying a
# contract; the violation handler it references lives in the experimental runtime,
# linked explicitly (Bazel appends linkopts after the objects, so the static
# archive resolves).
build --cxxopt=-fcontracts
build --linkopt=-lstdc++exp
# Enforcement semantic: a violation aborts in every mode, including the optimized
# --config=release build. A violation aborts cleanly rather than proceeding into
# undefined behavior, and the check costs nothing that matters -- the optimizer
# eliminates the predicates it can prove and the rest are below the noise floor.
# --config=release just sets -c opt; it does not relax the semantic.
build --cxxopt=-fcontract-evaluation-semantic=enforce
build:release --compilation_mode=opt
